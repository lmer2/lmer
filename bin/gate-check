#!/Agents/global/.venv/bin/python3
"""
Gate Check - Runs all gate checks without committing
"""

import sys
import os
import time

# Add src directory to path to use source files, not installed package
src_dir = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "src")
sys.path.insert(0, src_dir)

from lmer_cli.gates import GateSystem, commit_gate, receipt_argv

try:
    from work_repo.run_state import emit_gate_event
except ImportError:  # run-state wiring must never break a gate
    def emit_gate_event(gate, outcome, **kwargs):
        pass

try:
    from lmer_cli.gate_lock import hold_gate_lock
except ImportError:  # lock wiring must never break a gate, like receipts
    from contextlib import contextmanager

    @contextmanager
    def hold_gate_lock(label):
        yield


def main() -> int:
    verbose = '-v' in sys.argv or '--verbose' in sys.argv
    debug = '--debug' in sys.argv
    started = time.monotonic()
    # The marker covers the WHOLE command, receipt included (issue #201): a
    # work-repo commit landing anywhere in this window would move tracked
    # files under the running suite and fail its /work isolation guard.
    with hold_gate_lock("gate-check"):
        gate = GateSystem(verbose=verbose, debug=debug)
        rc = commit_gate(verbose=verbose, debug=debug, gate=gate)
        try:
            # Receipt assembly AND append are fail-soft: no receipt problem may
            # ever change the gate's exit code.
            emit_gate_event(
                "gate-check",
                "pass" if rc == 0 else "fail",
                exit_code=rc,
                duration_s=time.monotonic() - started,
                summary=gate.receipt_summary(),
                argv=receipt_argv(),
                # What the tests check actually covered, as data (#269): a
                # narrowed or cache-served run is a pass with exit code 0
                # exactly like a full one.
                **gate.receipt_test_fields(),
            )
        except Exception:
            pass
    return rc


if __name__ == "__main__":
    sys.exit(main())
