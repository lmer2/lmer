#!/Agents/global/.venv/bin/python3
"""
Gate Commit - Enforces all rules then commits if checks pass
"""

import sys
import os
import subprocess
import argparse
import time

# Add src directory to path to use source files, not installed package
src_dir = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "src")
sys.path.insert(0, src_dir)

from lmer_cli.gates import GateSystem, Colors, receipt_argv
from lmer_cli.util import get_bool_env

try:
    from work_repo.run_state import emit_gate_event
except ImportError:  # run-state wiring must never break a gate
    def emit_gate_event(gate, outcome, **kwargs):
        pass

try:
    from lmer_cli.gate_lock import hold_gate_lock
except ImportError:  # lock wiring must never break a gate, like receipts
    from contextlib import contextmanager

    @contextmanager
    def hold_gate_lock(label):
        yield


def _head_sha():
    """Best-effort sha of HEAD immediately after the commit; None when
    unreadable. Never raises — receipts are fail-soft."""
    try:
        result = subprocess.run(
            ["git", "rev-parse", "HEAD"],
            capture_output=True, text=True, check=False
        )
        if result.returncode == 0:
            return result.stdout.strip() or None
    except Exception:
        pass
    return None


def gate_commit(message: str, verbose: bool = False, bypass: bool = False):
    """Run gate checks and commit if passed.

    Emits exactly ONE gate receipt per invocation, at the end, so the
    receipt can carry the whole-command exit code and — when a commit
    actually landed (pass or bypass) — the resulting commit sha (#88).
    """
    started = time.monotonic()
    gate = None
    outcome = "bypass" if bypass else None

    def emit(exit_code, with_sha=False):
        # Receipt assembly AND append are fail-soft: no receipt problem may
        # ever change the gate's exit code (emit_gate_event guards its own
        # body, but summary/argv/sha assembly runs out here).
        try:
            emit_gate_event(
                "gate-commit",
                outcome,
                exit_code=exit_code,
                duration_s=time.monotonic() - started,
                summary=gate.receipt_summary() if gate is not None else None,
                argv=receipt_argv(),
                commit_sha=_head_sha() if with_sha else None,
                # What the tests check actually covered, as data (#269): a
                # narrowed or cache-served run is a pass with exit code 0
                # exactly like a full one. No gate (a bypass) and a skipped
                # suite alike contribute nothing, which is the receipt
                # saying "cannot tell" rather than claiming a full run.
                **(gate.receipt_test_fields() if gate is not None else {}),
            )
        except Exception:
            pass

    if bypass:
        print(f"{Colors.YELLOW}{Colors.BOLD}⚠️  GATE COMMIT - Bypassing checks{Colors.NC}\n")
    else:
        print(f"{Colors.CYAN}{Colors.BOLD}🔒 GATE COMMIT - Running checks...{Colors.NC}\n")

        # LMER_QUICK_GATE_COMMIT skips the slow test suite; gate-check and
        # gate-push still run it, so coverage is preserved at push time.
        # Accepts standard boolean strings (1/0, true/false, yes/no).
        skip_tests = get_bool_env("LMER_QUICK_GATE_COMMIT")
        if skip_tests:
            print(f"{Colors.YELLOW}ℹ️  LMER_QUICK_GATE_COMMIT enabled — tests will be skipped{Colors.NC}")

        # Run commit gate
        gate = GateSystem(verbose=verbose, commit_handoff=True)
        if not gate.run_commit_gate(skip_tests=skip_tests):
            print(f"\n{Colors.RED}❌ Commit aborted due to gate failures{Colors.NC}")
            outcome = "fail"
            emit(1)
            return 1
        outcome = "pass"

    # Check for Claude attribution in commit message
    claude_patterns = ["co-authored-by: claude", "co-authored-by: anthropic", "claude opus", "claude sonnet", "claude haiku", "noreply@anthropic.com"]
    msg_lower = message.lower()
    for pattern in claude_patterns:
        if pattern in msg_lower:
            print(f"\n{Colors.RED}❌ Commit message contains Claude attribution: '{pattern}'{Colors.NC}")
            print(f"{Colors.RED}   Remove it and try again.{Colors.NC}")
            emit(1)
            return 1

    # Commit with message
    if outcome == "pass":
        print(f"\n{Colors.GREEN}✅ Gate checks passed!{Colors.NC}")
    print(f"{Colors.CYAN}Committing with message: {message}{Colors.NC}")

    result = subprocess.run(["git", "commit", "-m", message], check=False)

    if result.returncode == 0:
        print(f"{Colors.GREEN}✅ Commit successful!{Colors.NC}")
        if gate is not None and gate.handoff_test_cache_after_commit():
            print(f"{Colors.GREEN}✅ Test cache handed off to the clean post-commit tree{Colors.NC}")
        emit(0, with_sha=True)
    else:
        print(f"{Colors.RED}❌ Commit failed{Colors.NC}")
        emit(result.returncode)

    return result.returncode


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Gate commit - enforces all rules before commit")
    parser.add_argument('-m', '--message', help='Commit message', required=True)
    parser.add_argument('-v', '--verbose', action='store_true', help='Verbose output')
    parser.add_argument('--bypass', action='store_true', help='Bypass gate checks')

    args = parser.parse_args()

    # Held across the whole command — checks, receipt AND the git commit
    # (issue #201). Wrapped here rather than inside gate_commit() so no early
    # return can leave the window uncovered.
    with hold_gate_lock("gate-commit"):
        rc = gate_commit(args.message, args.verbose, args.bypass)
    sys.exit(rc)
