#!/bin/bash
# Run a command inside the target service container.
#
# The target is whichever member `target-switch` last selected (issue #312),
# falling back to the one this session launched with. Read per invocation
# rather than from the environment alone, because a switch has to reach shells
# and agents that were already running when it happened.
#
# Usage:
#   target-exec <command> [args...]
#   target-exec pytest tests/ -x
#   target-exec python manage.py migrate

set -e

TARGET_FILE="${LMER_SERVICE_TARGET_FILE:-/home/developer/.lmer-session/service-target}"
SERVICE_NAME="$LMER_SERVICE_NAME"
SERVICE_CONTAINER="$LMER_SERVICE_CONTAINER"
SERVICE_WORKDIR="$LMER_SERVICE_WORKDIR"

if [ -f "$TARGET_FILE" ]; then
    { IFS= read -r FILE_NAME; IFS= read -r FILE_CONTAINER; IFS= read -r FILE_WORKDIR; } < "$TARGET_FILE" || true
    if [ -z "$FILE_CONTAINER" ]; then
        echo "❌ target-exec: $TARGET_FILE is malformed" >&2
        echo "   (expected service name, container id and workdir, one per line)" >&2
        echo "   Run: target-switch <service>" >&2
        exit 1
    fi
    SERVICE_NAME="$FILE_NAME"
    SERVICE_CONTAINER="$FILE_CONTAINER"
    SERVICE_WORKDIR="$FILE_WORKDIR"
fi

if [ -z "$SERVICE_CONTAINER" ]; then
    if [ -n "$LMER_SERVICE_GROUP" ]; then
        echo "❌ target-exec: no service selected yet in group '$LMER_SERVICE_GROUP'" >&2
        echo "   Run 'target-switch' to list the group's members, then" >&2
        echo "   'target-switch <service>' to pick one" >&2
    else
        echo "❌ target-exec: not in service mode (LMER_SERVICE_CONTAINER not set)" >&2
        echo "   Use --service <name> or --service-group <project> when launching lmer" >&2
    fi
    exit 1
fi

if [ $# -eq 0 ]; then
    echo "Usage: target-exec <command> [args...]" >&2
    echo "  Runs a command inside the target service container" >&2
    echo "  Service:   ${SERVICE_NAME:-unknown}" >&2
    echo "  Container: $SERVICE_CONTAINER" >&2
    echo "  Workdir:   ${SERVICE_WORKDIR:-/}" >&2
    exit 1
fi

exec docker exec -w "${SERVICE_WORKDIR:-/}" "$SERVICE_CONTAINER" "$@"
