#!/usr/bin/env bash
# bin/doctor — Container health check command
# Verifies that the container environment is fully operational.
# Exit codes: 0 = healthy (warnings OK), 1 = errors found, 2 = doctor itself failed

set -euo pipefail

# --- Path detection ---
# Check /Agents/global first, then $LMER_GLOBAL_DIR, then script's own parent dir
if [[ -d "/Agents/global" ]]; then
    GLOBAL_DIR="/Agents/global"
elif [[ -n "${LMER_GLOBAL_DIR:-}" && -d "$LMER_GLOBAL_DIR" ]]; then
    GLOBAL_DIR="$LMER_GLOBAL_DIR"
else
    GLOBAL_DIR="$(cd "$(dirname "$0")/.." && pwd)"
fi

# --- Flags ---
QUIET=false
VERBOSE=false
while [[ $# -gt 0 ]]; do
    case "$1" in
        -q|--quiet)  QUIET=true; shift ;;
        -v|--verbose) VERBOSE=true; shift ;;
        -h|--help)
            echo "Usage: bin/doctor [-q|--quiet] [-v|--verbose]"
            echo "  -q  Quiet mode: show errors only"
            echo "  -v  Verbose mode: show details for all checks"
            exit 0
            ;;
        *) echo "Unknown option: $1"; exit 2 ;;
    esac
done

# --- Counters ---
ERRORS=0
WARNINGS=0
PASSES=0

# --- Output helpers ---
pass() {
    PASSES=$((PASSES + 1))
    if ! $QUIET; then
        echo "  ✓ $1"
    fi
}

warn() {
    WARNINGS=$((WARNINGS + 1))
    if ! $QUIET; then
        echo "  ⚠️  $1"
    fi
}

error() {
    ERRORS=$((ERRORS + 1))
    echo "  ✗ $1"
}

detail() {
    if $VERBOSE; then
        echo "    → $1"
    fi
}

section() {
    if ! $QUIET; then
        echo ""
        echo "$1"
    fi
}

# --- Header ---
if ! $QUIET; then
    echo "============================================================"
    echo "🩺 DOCTOR — Container Health Check"
    echo "============================================================"
    detail "Global dir: $GLOBAL_DIR"
    # Provenance: which code is this, exactly? BUILD_INFO/LMER_BUILD_COMMIT
    # describe the baked image; LMER_SOURCE_COMMIT describes the host
    # checkout live-mounted over bin/src/hooks/… (dev mode; empty when the
    # session runs purely on the baked image).
    if [[ -f "$GLOBAL_DIR/BUILD_INFO" ]]; then
        echo "  image build: $(cat "$GLOBAL_DIR/BUILD_INFO")"
    elif [[ -n "${LMER_BUILD_COMMIT:-}" ]]; then
        echo "  image build: $LMER_BUILD_COMMIT"
    fi
    if [[ -n "${LMER_SOURCE_COMMIT:-}" ]]; then
        echo "  mounted source: $LMER_SOURCE_COMMIT"
    fi
fi

# =============================================================================
# 1. Slash Commands
# =============================================================================
section "📁 Slash Commands"

CLAUDE_COMMANDS="$HOME/.claude/commands"
if [[ -e "$CLAUDE_COMMANDS" ]]; then
    pass "~/.claude/commands exists"
    if [[ -L "$CLAUDE_COMMANDS" ]]; then
        LINK_TARGET="$(readlink "$CLAUDE_COMMANDS")"
        if [[ "$LINK_TARGET" == *"agent-files/claude/commands"* ]]; then
            pass "Symlink target correct: $LINK_TARGET"
        else
            error "Symlink points to unexpected target: $LINK_TARGET"
        fi
    else
        detail "~/.claude/commands is a directory (not a symlink)"
    fi
    MD_COUNT=$(find "$CLAUDE_COMMANDS" -maxdepth 1 -name '*.md' 2>/dev/null | wc -l)
    if [[ "$MD_COUNT" -gt 0 ]]; then
        pass "Found $MD_COUNT slash command(s)"
    else
        error "No .md files in ~/.claude/commands"
    fi
else
    error "~/.claude/commands does not exist"
fi

# =============================================================================
# 2. Settings & Credentials
# =============================================================================
section "⚙️  Settings & Credentials"

SETTINGS_FILE="$HOME/.claude/settings.json"
if [[ -e "$SETTINGS_FILE" ]]; then
    pass "settings.json exists"
    if [[ -L "$SETTINGS_FILE" ]]; then
        detail "Symlink target: $(readlink "$SETTINGS_FILE")"
    fi
else
    error "settings.json missing at $SETTINGS_FILE"
fi

CREDS_FILE="$HOME/.claude/.credentials.json"
if [[ -e "$CREDS_FILE" ]]; then
    pass ".credentials.json exists"
else
    error ".credentials.json missing — authentication will fail"
fi

MCP_FILE="$HOME/.mcp.json"
if [[ -e "$MCP_FILE" ]]; then
    pass ".mcp.json exists"
else
    warn ".mcp.json missing — MCP tools unavailable"
fi

# =============================================================================
# 3. Global Rules
# =============================================================================
section "📜 Global Rules"

if [[ -f "$GLOBAL_DIR/AGENTS.md" ]]; then
    pass "AGENTS.md accessible"
else
    error "AGENTS.md not found at $GLOBAL_DIR/AGENTS.md"
fi

if [[ -d "$GLOBAL_DIR/rules" ]]; then
    RULE_COUNT=$(find "$GLOBAL_DIR/rules" -maxdepth 1 -name '*.md' 2>/dev/null | wc -l)
    pass "rules/ directory exists ($RULE_COUNT rule files)"
else
    error "rules/ directory missing"
fi

if [[ -d "$GLOBAL_DIR/agent-files" ]]; then
    pass "agent-files/ directory exists"
else
    error "agent-files/ directory missing"
fi

# =============================================================================
# 4. Required Tools
# =============================================================================
section "🔧 Required Tools"

for tool in git python3 claude node; do
    if command -v "$tool" &>/dev/null; then
        if $VERBOSE; then
            tool_path="$(command -v "$tool")"
            pass "$tool available ($tool_path)"
        else
            pass "$tool available"
        fi
    else
        error "$tool not found on PATH"
    fi
done

# =============================================================================
# 5. Gate Commands
# =============================================================================
section "🔒 Gate Commands"

for gate in bin/gate-check bin/gate-commit bin/gate-push; do
    GATE_PATH="$GLOBAL_DIR/$gate"
    if [[ -x "$GATE_PATH" ]]; then
        pass "$gate executable"
    elif [[ -f "$GATE_PATH" ]]; then
        error "$gate exists but is not executable"
    else
        error "$gate not found"
    fi
done

# =============================================================================
# 6. Environment
# =============================================================================
section "🌍 Environment"

if [[ "$HOME" == "/home/developer" ]]; then
    pass "HOME=/home/developer"
else
    warn "HOME=$HOME (expected /home/developer in container)"
fi

if [[ ":$PATH:" == *":/Agents/global/bin:"* ]] || [[ ":$PATH:" == *":$GLOBAL_DIR/bin:"* ]]; then
    pass "PATH includes global bin directory"
else
    warn "PATH does not include $GLOBAL_DIR/bin"
    detail "PATH=$PATH"
fi

# =============================================================================
# 7. Workspace
# =============================================================================
section "📂 Workspace"

if [[ -d "/workspace" ]]; then
    pass "/workspace exists"
    if touch /workspace/.doctor-write-test 2>/dev/null; then
        rm -f /workspace/.doctor-write-test
        pass "/workspace is writable"
    else
        warn "/workspace is not writable"
    fi
else
    warn "/workspace does not exist"
fi

# =============================================================================
# 8. SSH Agent
# =============================================================================
section "🔑 SSH Agent"

if [[ -n "${SSH_AUTH_SOCK:-}" ]]; then
    pass "SSH_AUTH_SOCK is set"
    if [[ -S "$SSH_AUTH_SOCK" ]]; then
        pass "SSH socket is accessible"
    else
        warn "SSH_AUTH_SOCK set but socket not accessible: $SSH_AUTH_SOCK"
    fi
else
    warn "SSH_AUTH_SOCK not set — git push over SSH will fail"
fi

# =============================================================================
# 9. Python Environment
# =============================================================================
section "🐍 Python Environment"

if [[ -n "${VIRTUAL_ENV:-}" ]]; then
    pass "Virtual environment active: $VIRTUAL_ENV"
else
    warn "No virtual environment active"
fi

if "${LMER_PYTHON:-python3}" -c "import lmer_cli" &>/dev/null 2>&1; then
    pass "lmer_cli importable"
else
    warn "lmer_cli not importable"
fi

# =============================================================================
# 10. Declared Sources
# =============================================================================
section "🔗 Declared Sources"

# Reads ${LMER_WORK_REPO_PATH:-/work}/sources.yaml and reports declared-source
# reachability via the frozen helper CLI (lmer_cli.container.sources doctor;
# contract in that module's docstring). Every finding here is a WARNING,
# never an error — a broken declared source must not flip doctor's exit code.
# All URLs printed below come pre-scrubbed from the helper's JSON. The
# unredacted clone_url (--emit-clone-urls opt-in) is never echoed, never
# written to disk (the record loop is fed by process substitution, not a
# here-string, which bash backs with a $TMPDIR file), and never passed in
# argv (/proc/<pid>/cmdline is readable by everything else in this
# container) — git receives it through ephemeral GIT_CONFIG_* env, the same
# never-in-argv rule the clone cache follows.
SOURCES_YAML="${LMER_WORK_REPO_PATH:-/work}/sources.yaml"
# Renderer-supported taskdef schemas, captured from the helper's doctor
# document (supported_taskdef_schemas) — never re-derived in shell. Filled
# by the META record below; the taskdef schema check re-asks the helper if
# it is still empty (legacy mode: no sources.yaml, but /taskdef cloned via
# the env-var override path).
SUPPORTED_TASKDEF_SCHEMAS_CSV=""
if [[ ! -f "$SOURCES_YAML" ]]; then
    # Absent file is silent legacy mode (spec G5) — a skip note, not a finding.
    if ! $QUIET; then
        echo "  - no sources.yaml at $SOURCES_YAML — silent legacy mode, checks skipped"
    fi
else
    # One helper invocation. --path is passed explicitly even though the
    # helper's own default resolves to the same $LMER_WORK_REPO_PATH file:
    # the path checked above is the one reported in the messages below, and
    # this is the section's test seam. On a validation refusal (exit 2) the
    # helper still emits one JSON document, so the exit code is deliberately
    # ignored in favor of the document.
    SOURCES_JSON="$("${LMER_PYTHON:-python3}" -m lmer_cli.container.sources doctor \
        --json --emit-clone-urls --path "$SOURCES_YAML" 2>/dev/null)" || true
    # Flatten the JSON to unit-separator records (jq is not part of the
    # container contract; python3 is already a required tool above).
    SOURCES_PARSED=""
    if [[ -n "${SOURCES_JSON:-}" ]]; then
        SOURCES_PARSED="$(printf '%s' "$SOURCES_JSON" | "${LMER_PYTHON:-python3}" -c '
import json, sys
SEP = chr(31)
def clean(v):
    if v is None:
        return ""
    return str(v).replace(SEP, " ").replace("\n", " ").replace("\r", " ")
try:
    doc = json.load(sys.stdin)
    if not isinstance(doc, dict):
        raise ValueError("not a JSON object")
except Exception:
    sys.exit(3)
rows = [["META",
         "1" if doc.get("ok") else "0",
         clean(doc.get("schema")),
         ",".join(str(s) for s in doc.get("supported_taskdef_schemas") or [])]]
for w in doc.get("warnings") or []:
    rows.append(["WARN", clean(w)])
for e in doc.get("errors") or []:
    rows.append(["ERR", clean(e)])
srcs = doc.get("sources")
if isinstance(srcs, dict):
    for name, entry in srcs.items():
        if not isinstance(entry, dict):
            continue
        rows.append(["SRC", clean(name), clean(entry.get("mode")),
                     "1" if entry.get("anonymous") else "0",
                     clean(entry.get("ref")), clean(entry.get("repo")),
                     clean(entry.get("clone_url"))])
for row in rows:
    print(SEP.join(row))
' 2>/dev/null)" || true
    fi
    if [[ -z "$SOURCES_PARSED" ]]; then
        # Degrade to a single warning: python3/the helper module unavailable,
        # or the helper emitted nothing parseable.
        warn "sources.yaml present but the sources helper is unavailable or its output was unparseable — declared sources unchecked"
        detail "tried: ${LMER_PYTHON:-python3} -m lmer_cli.container.sources doctor --json --path $SOURCES_YAML"
    else
        LS_REMOTE_CMD=(git ls-remote --)
        if command -v timeout &>/dev/null; then
            LS_REMOTE_CMD=(timeout 20 git ls-remote --)
        fi
        while IFS=$'\x1f' read -r REC_TAG REC_1 REC_2 REC_3 REC_4 REC_5 REC_6; do
            case "$REC_TAG" in
                META)
                    if [[ "$REC_1" == "1" ]]; then
                        pass "sources.yaml valid (schema $REC_2)"
                    fi
                    SUPPORTED_TASKDEF_SCHEMAS_CSV="$REC_3"
                    detail "supported taskdef schemas: $REC_3"
                    ;;
                WARN|ERR)
                    # Helper findings (load warnings, refusal errors) are all
                    # warnings here — doctor's exit semantics stay unchanged.
                    warn "$REC_1"
                    ;;
                SRC)
                    SRC_NAME="$REC_1"; SRC_MODE="$REC_2"; SRC_ANON="$REC_3"
                    SRC_REF="$REC_4"; SRC_REPO="$REC_5"; SRC_CLONE_URL="$REC_6"
                    if [[ -z "$SRC_CLONE_URL" ]]; then
                        # No derivation (no work-repo URL) — the helper's own
                        # warning above already covers it once.
                        detail "$SRC_NAME: clone URL not derived — reachability not checked"
                        continue
                    fi
                    LS_REMOTE_OUT=""
                    # argv carries the SCRUBBED declared URL; the credentialed
                    # form reaches git as an ephemeral url.<credentialed>
                    # .insteadOf rewrite in the subshell's environment, so the
                    # token never lands in /proc/<pid>/cmdline. Numbered
                    # entries are appended after any inherited GIT_CONFIG_*
                    # so an outer numbered config is never clobbered.
                    GIT_CFG_N="${GIT_CONFIG_COUNT:-0}"
                    [[ "$GIT_CFG_N" =~ ^[0-9]+$ ]] || GIT_CFG_N=0
                    if LS_REMOTE_OUT="$(
                        export GIT_TERMINAL_PROMPT=0
                        export GIT_SSH_COMMAND='ssh -o BatchMode=yes -o ConnectTimeout=10'
                        export GIT_CONFIG_COUNT="$((GIT_CFG_N + 1))"
                        export "GIT_CONFIG_KEY_${GIT_CFG_N}=url.${SRC_CLONE_URL}.insteadOf"
                        export "GIT_CONFIG_VALUE_${GIT_CFG_N}=${SRC_REPO}"
                        "${LS_REMOTE_CMD[@]}" "$SRC_REPO" 2>/dev/null </dev/null
                    )"; then
                        pass "$SRC_NAME source reachable: $SRC_REPO (mode: $SRC_MODE)"
                        if [[ -n "$SRC_REF" ]]; then
                            # Accept branch, tag, full ref path, or full SHA.
                            # Matched in-shell rather than through a
                            # `printf | cut | grep -q` pipeline ON PURPOSE:
                            # under `set -o pipefail` an early-exiting matcher
                            # leaves the upstream writer holding unwritten
                            # output, it dies of SIGPIPE, and 141 becomes the
                            # pipeline's status — so a ref that IS present
                            # reads as absent as soon as ls-remote output
                            # outgrows the pipe buffer (~1000 refs). The
                            # process substitution below is not part of the
                            # `if` condition's status, so an early break here
                            # cannot be mistaken for "not found".
                            REF_PRESENT=false
                            while IFS=$'\t' read -r LS_SHA LS_REF; do
                                if [[ "$LS_REF" == "refs/heads/$SRC_REF" ||
                                      "$LS_REF" == "refs/tags/$SRC_REF" ||
                                      "$LS_REF" == "$SRC_REF" ||
                                      "$LS_SHA" == "$SRC_REF" ]]; then
                                    REF_PRESENT=true
                                    break
                                fi
                            done < <(printf '%s\n' "$LS_REMOTE_OUT")
                            if $REF_PRESENT; then
                                pass "$SRC_NAME ref '$SRC_REF' present on remote"
                            else
                                warn "$SRC_NAME ref '$SRC_REF' not found on $SRC_REPO — fix sources.taskdef.ref in $SOURCES_YAML or push the ref"
                            fi
                        fi
                    else
                        SRC_REMEDY="check host reachability and that the work-repo credential grants read access"
                        # Both anonymous modes clone credential-less, but for
                        # different reasons; naming the wrong one sends the
                        # operator to look at the wrong thing.
                        if [[ "$SRC_MODE" == "anonymous-other-port" ]]; then
                            SRC_REMEDY="the declaration names a different port than the work repo, so the work-repo credential was withheld — the repo must be publicly readable on that port, or use the env var override"
                        elif [[ "$SRC_ANON" == "1" ]]; then
                            SRC_REMEDY="anonymous derivation (credential-less work-repo URL) — the repo must be publicly readable, or use the env var override"
                        fi
                        warn "$SRC_NAME source unreachable: $SRC_REPO (mode: $SRC_MODE) — git ls-remote failed; $SRC_REMEDY"
                    fi
                    ;;
            esac
        done < <(printf '%s\n' "$SOURCES_PARSED")
    fi
fi

# --- Taskdef schema (local manifest vs renderer support) ---
# Reads the ROOT taskdef.yaml of the /taskdef clone LOCALLY — no remote
# fetch of any kind. An absent clone is a skip note (nothing to check);
# a clone with no root taskdef.yaml is schema 1 (grandfather clause,
# hooks/start.py read_taskdef_schema). Findings stay warnings, never errors.
# The dir is a variable only as a test seam; the real clone path is /taskdef
# (clone_and_exec._SOURCE_DESTS).
TASKDEF_CLONE_DIR="${LMER_DOCTOR_TASKDEF_DIR:-/taskdef}"
TASKDEF_MANIFEST="$TASKDEF_CLONE_DIR/taskdef.yaml"
if [[ ! -d "$TASKDEF_CLONE_DIR" ]]; then
    if ! $QUIET; then
        echo "  - no taskdef clone at $TASKDEF_CLONE_DIR — taskdef schema check skipped"
    fi
elif [[ ! -f "$TASKDEF_MANIFEST" ]]; then
    pass "taskdef clone has no root taskdef.yaml — schema 1 (grandfather clause)"
else
    if [[ -z "$SUPPORTED_TASKDEF_SCHEMAS_CSV" ]]; then
        # Legacy mode or earlier parse failure — one extra helper call for
        # the supported set only (emitted even when sources.yaml is absent).
        SUPPORTED_TASKDEF_SCHEMAS_CSV="$("${LMER_PYTHON:-python3}" -m lmer_cli.container.sources doctor \
            --json --path "$SOURCES_YAML" 2>/dev/null \
            | "${LMER_PYTHON:-python3}" -c '
import json, sys
try:
    doc = json.load(sys.stdin)
    if not isinstance(doc, dict):
        raise ValueError("not a JSON object")
except Exception:
    sys.exit(3)
print(",".join(str(s) for s in doc.get("supported_taskdef_schemas") or []))
' 2>/dev/null)" || true
    fi
    # Same guarded-python3 approach as the sources parse; PyYAML so the
    # YAML-bool trap is handled (`schema: true` must NOT pass — mirrors
    # hooks/start.py read_taskdef_schema, which rejects bools explicitly).
    TASKDEF_SCHEMA="$("${LMER_PYTHON:-python3}" -c '
import sys
try:
    import yaml
except Exception:
    print("NOYAML"); sys.exit(0)
try:
    with open(sys.argv[1]) as f:
        data = yaml.safe_load(f)
except Exception:
    print("UNPARSEABLE"); sys.exit(0)
schema = data.get("schema") if isinstance(data, dict) else None
if isinstance(schema, bool) or not isinstance(schema, int):
    print("INVALID"); sys.exit(0)
print(schema)
' "$TASKDEF_MANIFEST" 2>/dev/null)" || true
    case "$TASKDEF_SCHEMA" in
        "")
            warn "$TASKDEF_MANIFEST present but python3 unavailable — taskdef schema not verified"
            ;;
        NOYAML)
            warn "$TASKDEF_MANIFEST present but PyYAML unavailable — taskdef schema not verified"
            ;;
        UNPARSEABLE)
            warn "$TASKDEF_MANIFEST is not readable/parseable YAML — the taskdef renderer will refuse it; fix or remove the manifest"
            ;;
        INVALID)
            warn "$TASKDEF_MANIFEST must declare an integer \`schema:\` (a YAML bool like \`schema: true\` does not count) — the renderer will refuse it; declare one of: ${SUPPORTED_TASKDEF_SCHEMAS_CSV:-unknown}"
            ;;
        *)
            if [[ -z "$SUPPORTED_TASKDEF_SCHEMAS_CSV" ]]; then
                warn "taskdef declares schema $TASKDEF_SCHEMA but the sources helper is unavailable — supported set unknown, schema not verified"
            elif [[ ",$SUPPORTED_TASKDEF_SCHEMAS_CSV," == *",$TASKDEF_SCHEMA,"* ]]; then
                pass "taskdef schema $TASKDEF_SCHEMA supported by this renderer (supports: $SUPPORTED_TASKDEF_SCHEMAS_CSV)"
            else
                warn "taskdef declares schema $TASKDEF_SCHEMA but this renderer supports only: $SUPPORTED_TASKDEF_SCHEMAS_CSV — upgrade the container image, or pin sources.taskdef.ref (in $SOURCES_YAML) to a ref using a supported schema"
            fi
            ;;
    esac
fi

# =============================================================================
# Summary
# =============================================================================
echo ""
echo "============================================================"
echo "🎯 Summary"
echo "============================================================"
TOTAL=$((PASSES + WARNINGS + ERRORS))
echo "  ✓ Passed:   $PASSES"
echo "  ⚠️  Warnings: $WARNINGS"
echo "  ✗ Errors:   $ERRORS"
echo "  Total:      $TOTAL checks"
echo ""

if [[ "$ERRORS" -gt 0 ]]; then
    echo "❌ $ERRORS error(s) found — environment is NOT healthy"
    exit 1
elif [[ "$WARNINGS" -gt 0 ]]; then
    echo "✅ Healthy (with $WARNINGS warning(s))"
    exit 0
else
    echo "✅ All checks passed — environment is fully operational"
    exit 0
fi
